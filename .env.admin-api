# Admin API Authentication
ADMIN_USERNAME=admin
# This is a bcrypt hash for password "asdfre32"
ADMIN_PASSWORD_HASH=$2b$12$Vpj/uoizndG.JmoQg09vIO./kQioWRFnEESlnVBhz9Pbck0EO1CK2
# REQUIRED. Minimum 64 chars. Known-weak placeholders are rejected at startup.
